@Code
    ViewData("Title") = "Página de inicio"
End Code

<div class="jumbotron">
    <h1>ASP.NET</h1>
    <p class="lead">ASP.NET es un marco de trabajo web gratuito para crear sitios y aplicaciones web con HTML, CSS y JavaScript.</p>
    <p><a href="https://asp.net" class="btn btn-primary btn-lg">Más información &raquo;</a></p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Primeros pasos</h2>
        <p>
            ASP.NET MVC ofrece una forma basada en patrones para crear sitios web dinámicos,
            facilita una separación clara de responsabilidades y brinda control sobre el marcado
            para agilizar el desarrollo.
        </p>
        <p><a class="btn btn-default" href="https://go.microsoft.com/fwlink/?LinkId=301865">Más información &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Obtenga más bibliotecas</h2>
        <p>NuGet es una extensión gratuita de Visual Studio que facilita agregar, quitar y actualizar bibliotecas y herramientas en los proyectos.</p>
        <p><a class="btn btn-default" href="https://go.microsoft.com/fwlink/?LinkId=301866">Más información &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Alojamiento web</h2>
        <p>Puede encontrar fácilmente un servicio de alojamiento web con las características y el precio adecuados para sus aplicaciones.</p>
        <p><a class="btn btn-default" href="https://go.microsoft.com/fwlink/?LinkId=301867">Más información &raquo;</a></p>
    </div>
</div>
